# =====================================================================
# Environment variables for docker compose.
# Copy this file to .env and set real values:   cp .env.example .env
# .env is gitignored – never commit real passwords.
# =====================================================================

# PostgreSQL (docker-compose.yml -> service "db")
POSTGRES_DB=coworking_db
POSTGRES_USER=coworking
POSTGRES_PASSWORD=change-me
# Host port. Change it only if 5432 is taken on your machine.
POSTGRES_PORT=5432
